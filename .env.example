# ============================================================
# DocXpert — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Database
DATABASE_URL=sqlite:///database/docxpert.db

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Server
HOST=0.0.0.0
PORT=5000
DEBUG=true

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5000,http://localhost:3000,http://127.0.0.1:5000

# Secret key (change in production!)
SECRET_KEY=change-me-in-production

# Groq AI API (required for features 4, 6)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# LanguageTool API (used for feature 7 — spell check)
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check
LANGUAGETOOL_LANGUAGE=en-US

# LibreOffice path (auto-detected on macOS if left empty)
LIBREOFFICE_PATH=
